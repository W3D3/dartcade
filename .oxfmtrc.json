{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "printWidth": 140,
  "sortPackageJson": false,
  "svelte": {},
  "ignorePatterns": [
    ".claude/",
    ".remember/",
    "backend/src/schema/",
    "schema/types.ts",
    "backend/frontend/src/lib/api/schema.ts",
    "backend/frontend/src/lib/api/game-ws.ts",
    "backend/frontend/src/lib/api/lobby-ws.ts",
    "backend/frontend/src/lib/api/zod.ts",
    "bridge/",
    "spike/",
    "fixtures/",
    "package-lock.json",
    "dist/",
    "AGENTS.md",
    "backend/frontend/public/voices/*/LICENSE.md",
    "backend/frontend/src/assets/fonts/LICENSES.md"
  ],
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
