# Preview sample data (src/seed/sample.ts): sprout runs this once the preview app is healthy
FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
COPY package*.json ./
COPY tsconfig.json ./
RUN npm ci
COPY src/ ./src/
RUN npx tsc
CMD ["node", "dist/seed/main.js"]
