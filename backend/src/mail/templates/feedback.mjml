<mjml>
  <mj-include path="./head.mjml" />
  <mj-body background-color="#0f100e" width="560px">
    <mj-section background-color="#131511" border="1px solid #2a2d27" border-radius="12px" padding="40px 32px">
      <mj-column>
        <mj-text align="center" font-family="'Barlow Condensed', 'Arial Narrow', Arial, sans-serif" font-weight="700" text-transform="uppercase" letter-spacing="0.06em" font-size="20px" color="#efeee6" padding="0 0 28px 0">
          Dartcade
        </mj-text>
        <mj-text align="left" font-family="'Barlow Condensed', 'Arial Narrow', Arial, sans-serif" font-weight="700" text-transform="uppercase" font-size="32px" line-height="1.15" color="#efeee6" padding="0 0 16px 0">
          {{heading}}
        </mj-text>
        <mj-text align="left" color="#efeee6" padding="0 0 28px 0">
          <div style="white-space:pre-wrap;">{{message}}</div>
        </mj-text>
        <mj-table font-size="13px" color="#a3a498" padding="0">
          {{rows}}
        </mj-table>
        <mj-text align="center" font-size="13px" color="#828379" padding="28px 0 0 0">
          {{note}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
