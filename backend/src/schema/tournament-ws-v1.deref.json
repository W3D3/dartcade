    "TournamentLiveTable": {
      "title": "TournamentLiveTable",
      "type": "object",
      "required": [
        "group",
        "rows"
      ],
      "additionalProperties": false,
      "description": "A group's table, or a round robin's (group null), best first.",
      "properties": {
        "group": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "title": "TournamentLiveStanding",
            "type": "object",
            "required": [
              "entryId",
              "played",
              "won",
              "lost",
              "legsWon",
              "legsLost"
            ],
            "additionalProperties": false,
            "properties": {
              "entryId": {
                "type": "string"
              },
              "played": {
                "type": "integer"
              },
              "won": {
                "type": "integer"
              },
              "lost": {
                "type": "integer"
              },
              "legsWon": {
                "type": "integer"
              },
              "legsLost": {
                "type": "integer"
              }
