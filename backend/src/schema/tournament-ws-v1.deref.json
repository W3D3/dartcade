      "additionalProperties": false,
      "properties": {
        "bracket": {
          "type": "string",
          "enum": [
            "main",
            "lower",
            "final",
            "group"
          ]
        },
        "round": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "description": "Quarter-finals, Lower round 2, Grand final, Groups · round 1, …"
        },
        "state": {
          "type": "string",
          "enum": [
            "done",
            "now",
            "later"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "For a later stage: when it is expected to start."
        }
      }
    },
