{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$shared": ["../src/shared"],
      "$shared/*": ["../src/shared/*"],
      // $shared/minigolf imports this; resolved from here, where it's installed too (as vite's dedupe)
      "@newkrok/nape-js": ["./node_modules/@newkrok/nape-js"]
    }
  },
  "include": ["src/**/*", "*.ts"]
}
