{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$shared": ["../src/shared"],
      "$shared/*": ["../src/shared/*"],
      // $shared/minigolf imports these; resolved from here, where they're installed too (as vite's dedupe)
      "@newkrok/nape-js": ["./node_modules/@newkrok/nape-js"],
      "@dimforge/rapier3d-deterministic-compat": ["./node_modules/@dimforge/rapier3d-deterministic-compat"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*", "*.ts"]
}
