{
  "name": "dartcade-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "gen:types": "json-schema-to-typescript ../schema/adbridge-v1.json -o src/schema/types.ts --no-additionalProperties"
  },
  "dependencies": {
    "@fastify/static": "7.0.4",
    "@fastify/websocket": "8.3.1",
    "better-auth": "1.7.6",
    "fastify": "4.29.1",
    "kysely": "0.28.17",
    "pg": "8.23.0",
    "ulid": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "json-schema-to-typescript": "14.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
