  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts ../schema/adbridge-v1.json -o src/schema/types.ts --no-additionalProperties",
    "lint": "oxlint",
    "calibrate:bots": "tsx src/bots/calibrate.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "7.0.4",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.2.0",
    "@fastify/websocket": "8.3.1",
    "@openfeature/server-sdk": "1.23.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.6",
    "better-auth-vetto": "0.2.1",
    "fastify": "4.29.1",
    "kysely": "0.28.17",
    "marked": "^18.1.1",
    "mjml": "^5.4.1",
    "nodemailer": "^10.1.2",
    "pg": "8.23.0",
    "piscina": "5.3.2",
    "polyclip-ts": "0.16.8",
    "semver": "7.8.5",
    "ulid": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mjml": "^5.0.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "json-schema-to-typescript": "14.1.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
