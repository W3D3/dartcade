{
  "name": "dartcade-backend",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts ../schema/adbridge-v1.json -o src/schema/types.ts --no-additionalProperties",
    "lint": "oxlint",
    "calibrate:bots": "tsx src/bots/calibrate.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "7.0.4",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.2.0",
    "@fastify/websocket": "8.3.1",
    "@newkrok/nape-js": "3.43.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.6",
    "fastify": "4.29.1",
    "kysely": "0.28.17",
    "pg": "8.23.0",
    "ulid": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "json-schema-to-typescript": "14.1.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
