# Copy to .env and fill in values
# docker compose -f docker-compose.dev.yaml up

# Your Autodarts board's local IP (required)
DARTCADE_BOARD_URL=http://192.168.1.x:3180

# Optional: open the dev stack from another device (e.g. over Tailscale).
# Origins allowed to sign in, comma-separated, e.g. http://100.x.y.z:5173,http://myhost.tailnet.ts.net:5173
DARTCADE_EXTRA_ORIGINS=
# Hostnames Vite answers to besides localhost and IPs, e.g. myhost.tailnet.ts.net
DARTCADE_EXTRA_HOSTS=
