{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common/v1",
  "title": "Common",
  "description": "Definitions shared by api-v1.yaml (HTTP), game-ws-v1.json and lobby-ws-v1.json (WebSockets). Must stay valid in both OpenAPI 3.0 and JSON Schema draft-07: no `const`, no type arrays, no `nullable`.",
  "$defs": {
    "Player": {
      "title": "Player",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "Segment": {
      "title": "Segment",
      "description": "A board segment as Board Manager reports it. Bull 25: bed=Single, number=25. Bull 50: bed=Double, number=50. Miss: name=Miss, number=0, bed=Outside, multiplier=0.",
      "type": "object",
      "required": ["name", "number", "bed", "multiplier"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "integer", "minimum": 0, "maximum": 50 },
        "bed": { "type": "string", "enum": ["SingleInner", "SingleOuter", "Single", "Double", "Triple", "Outside"] },
        "multiplier": { "type": "integer", "enum": [0, 1, 2, 3] }
      }
    },
    "Coords": {
      "title": "Coords",
      "description": "Bull-centred, r = 1 at the outer double wire, x right, y up.",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Polar": {
      "title": "Polar",
      "type": "object",
      "required": ["r", "theta_deg"],
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number", "minimum": 0 },
        "theta_deg": { "type": "number" }
      }
    },
    "Dart": {
      "title": "Dart",
      "description": "A thrown dart. coords/polar are absent for manual entry and bounce-outs.",
      "type": "object",
      "required": ["segment", "score"],
      "additionalProperties": false,
      "properties": {
        "segment": { "$ref": "#/$defs/Segment" },
        "score": { "type": "integer", "minimum": 0 },
        "coords": { "$ref": "#/$defs/Coords" },
        "polar": { "$ref": "#/$defs/Polar" },
        "bouncer": { "type": "boolean" }
      }
    },
    "GameFormat": {
      "title": "GameFormat",
      "type": "string",
      "enum": ["singles", "teams"],
      "description": "Singles: every player for themselves. Teams: Team A against Team B, each sharing a score."
    },
    "TeamId": {
      "title": "TeamId",
      "type": "string",
      "enum": ["A", "B"]
    },
    "TeamView": {
      "title": "TeamView",
      "type": "object",
      "required": ["id", "name", "seats"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/TeamId" },
        "name": { "type": "string" },
        "seats": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "The team's seats in its own throwing order." }
      }
    },
    "ErrorResponse": {
      "title": "ErrorResponse",
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": { "type": "string" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "UserRef": {
      "title": "UserRef",
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string", "description": "Their handle, shown as @name" } }
    },
    "FriendPlaying": {
      "title": "FriendPlaying",
      "type": "object",
      "required": ["kind", "gameId"],
      "additionalProperties": false,
      "properties": { "kind": { "type": "string", "enum": ["playing"] }, "gameId": { "type": "string" } }
    },
    "FriendInLobby": {
      "title": "FriendInLobby",
      "type": "object",
      "required": ["kind", "lobbyId", "lobbyName", "joinable"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["lobby"] },
        "lobbyId": { "type": "string" },
        "lobbyName": { "type": "string" },
        "joinable": { "type": "boolean", "description": "The lobby is open to friends and its host is your friend: join without the code" }
      }
    },
    "FriendOnline": {
      "title": "FriendOnline",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "type": "string", "enum": ["online"] } }
    },
    "FriendOffline": {
      "title": "FriendOffline",
      "description": "Offline, or Invisible",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "type": "string", "enum": ["offline"] } }
    },
    "FriendStatus": {
      "title": "FriendStatus",
      "description": "What you see of a friend, first match wins: playing (seated in a running game), lobby (in an open lobby), online, offline. Only while they're online and not Invisible.",
      "oneOf": [
        { "$ref": "#/$defs/FriendPlaying" }, { "$ref": "#/$defs/FriendInLobby" },
        { "$ref": "#/$defs/FriendOnline" }, { "$ref": "#/$defs/FriendOffline" }
      ]
    },
    "Friend": {
      "title": "Friend",
      "type": "object",
      "required": ["id", "name", "friendsSince", "status", "inYourLobby", "invited"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "friendsSince": { "type": "string", "format": "date-time" },
        "status": { "$ref": "#/$defs/FriendStatus" },
        "inYourLobby": { "type": "boolean", "description": "They're in the lobby you're in (shown even while they're Invisible: you see them there anyway)" },
        "invited": { "type": "boolean", "description": "They have a pending invite to your lobby" }
      }
    },
    "IncomingFriendRequest": {
      "title": "IncomingFriendRequest",
      "type": "object",
      "required": ["id", "from", "mutualFriends", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/$defs/UserRef" },
        "mutualFriends": { "type": "integer", "minimum": 0, "description": "Friends you both have (\"3 friends in common\")" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "OutgoingFriendRequest": {
      "title": "OutgoingFriendRequest",
      "type": "object",
      "required": ["id", "to", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "to": { "$ref": "#/$defs/UserRef" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FriendList": {
      "title": "FriendList",
      "description": "Your friends (by name), requests for you and requests you sent (newest first).",
      "type": "object",
      "required": ["friends", "incoming", "outgoing"],
      "additionalProperties": false,
      "properties": {
        "friends": { "type": "array", "items": { "$ref": "#/$defs/Friend" } },
        "incoming": { "type": "array", "items": { "$ref": "#/$defs/IncomingFriendRequest" } },
        "outgoing": { "type": "array", "items": { "$ref": "#/$defs/OutgoingFriendRequest" } }
      }
    }
  }
}
