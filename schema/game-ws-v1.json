{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "game-ws/v1",
  "title": "GameWs",
  "description": "Messages on the game WebSocket (/ws?sessionId=…) between the browser and the backend. Server → client: Snapshot, NoticeMessage, ErrorMessage, CameraMessage. Client → server: ClientMessage. The server closes the socket with a WsCloseCode.",
  "$defs": {
    "WsCloseCode": {
      "title": "WsCloseCode",
      "description": "Close codes the backend sends. The client stops reconnecting on Unauthorized (go to login), Forbidden and NotFound.",
      "type": "integer",
      "enum": [4400, 4401, 4403, 4404, 4500],
      "tsEnumNames": ["MissingSession", "Unauthorized", "Forbidden", "NotFound", "InternalError"]
    },
    "BmStatus": {
      "title": "BmStatus",
      "type": "object",
      "required": ["status", "running", "event"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "event": {
          "type": "string"
        }
      }
    },
    "BullOffThrow": {
      "title": "BullOffThrow",
      "type": "object",
      "required": ["mm", "segment", "thetaDeg", "estimated"],
      "additionalProperties": false,
      "properties": {
        "mm": {
          "type": ["number", "null"],
          "description": "Distance from the centre; null = off the board"
        },
        "segment": {
          "type": "string"
        },
        "thetaDeg": {
          "type": ["number", "null"]
        },
        "estimated": {
          "type": "boolean",
          "description": "Distance estimated from the segment (manual entry or a corrected dart)"
        }
      }
    },
    "BullOffResult": {
      "title": "BullOffResult",
      "type": "object",
      "required": ["order", "rethrow"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "rethrow": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": ["tie", "bullseye", "all_missed"]
        }
      }
    },
    "BullOffView": {
      "title": "BullOffView",
      "type": "object",
      "required": ["throws", "sequence", "currentPlayer", "result"],
      "additionalProperties": false,
      "properties": {
        "throws": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/BullOffThrow"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "sequence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "currentPlayer": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/BullOffResult"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "X01Game": {
      "title": "X01Game",
      "description": "X01 view plus the engine's per-session fields and the bull off.",
      "type": "object",
      "required": [
        "scores",
        "legs",
        "firstTo",
        "currentPlayer",
        "nextPlayer",
        "round",
        "phase",
        "winner",
        "opened",
        "bustThisVisit",
        "config",
        "visitLocked",
        "bullOff",
        "currentVisitDarts",
        "totalDarts",
        "totalVisits",
        "pointsScored",
        "dartsThrown",
        "legVisits",
        "lastVisit",
        "checkoutAttempts",
        "checkoutHits",
        "visitStartScores"
      ],
      "additionalProperties": false,
      "properties": {
        "scores": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "firstTo": {
          "type": "integer",
          "minimum": 1
        },
        "currentPlayer": {
          "type": "integer",
          "minimum": 0
        },
        "nextPlayer": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "The seat that throws after the open visit: after a checkout the next leg's starter; null when the visit ends the game, once it is over, and during the bull off."
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": ["bulloff", "game", "finished"]
        },
        "winner": {
          "type": ["integer", "null"]
        },
        "opened": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "bustThisVisit": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "required": ["outMode", "startScore", "inMode", "botSpeed"],
          "additionalProperties": false,
          "properties": {
            "outMode": {
              "type": "string",
              "enum": ["straight", "double", "master"]
            },
            "startScore": {
              "type": "integer",
              "minimum": 2
            },
            "inMode": {
              "type": "string",
              "enum": ["straight", "double", "master"]
            },
            "botSpeed": {
              "type": "string",
              "enum": ["fast", "normal", "slow"]
            }
          }
        },
        "visitLocked": {
          "type": "boolean"
        },
        "bullOff": {
          "anyOf": [
            {
              "$ref": "#/$defs/BullOffView"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentVisitDarts": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Dart"
          }
        },
        "totalDarts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "totalVisits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pointsScored": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Per seat: points scored in committed visits (busts count 0)."
        },
        "dartsThrown": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Per seat: darts in committed visits; with pointsScored, the match average."
        },
        "legVisits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/X01Visit"
          },
          "description": "This leg's committed visits, in throwing order."
        },
        "lastVisit": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/X01Visit"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Per seat: their last committed visit, kept across legs; null before their first."
        },
        "checkoutAttempts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Per seat: darts thrown on a one-dart finish, wherever they landed."
        },
        "checkoutHits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Per seat: of those, the darts that finished the leg."
        },
        "visitStartScores": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Per seat: the team's score when its open (or next) visit started."
        },
        "teams": {
          "type": "array",
          "description": "Only in a team game: each team with its shared score and legs.",
          "items": {
            "type": "object",
            "required": ["id", "name", "seats", "score", "legs"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common-v1.json#/$defs/TeamId"
              },
              "name": {
                "type": "string"
              },
              "seats": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "The team's seats in its own throwing order."
              },
              "score": {
                "type": "integer"
              },
              "legs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "X01Visit": {
      "title": "X01Visit",
      "description": "A committed X01 visit.",
      "type": "object",
      "required": ["seat", "scored", "left", "bust", "darts"],
      "additionalProperties": false,
      "properties": {
        "seat": {
          "type": "integer",
          "minimum": 0
        },
        "scored": {
          "type": "integer",
          "minimum": 0,
          "description": "Points the visit scored; 0 on a bust or before opening."
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "description": "The team's score after the visit."
        },
        "bust": {
          "type": "boolean"
        },
        "darts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AtcGame": {
      "title": "AtcGame",
      "description": "Around the Clock view plus the engine's per-session fields.",
      "type": "object",
      "required": [
        "targets",
        "sequence",
        "currentPlayer",
        "winner",
        "cfg",
        "currentVisitHits",
        "hitCounts",
        "currentVisitDarts",
        "totalDarts",
        "totalVisits"
      ],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "sequence": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "currentPlayer": {
          "type": "integer",
          "minimum": 0
        },
        "winner": {
          "type": ["integer", "null"]
        },
        "cfg": {
          "type": "object",
          "required": ["throwAgainOnAllHit", "finishOn", "multiplierAdvances", "order"],
          "additionalProperties": false,
          "properties": {
            "throwAgainOnAllHit": {
              "type": "boolean"
            },
            "finishOn": {
              "type": "string",
              "enum": ["twenty", "single_bull", "bull"]
            },
            "multiplierAdvances": {
              "type": "boolean"
            },
            "order": {
              "type": "string",
              "enum": ["asc", "desc", "random"]
            }
          }
        },
        "currentVisitHits": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "hitCounts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "currentVisitDarts": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Dart"
          }
        },
        "totalDarts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "totalVisits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SeatInfo": {
      "title": "SeatInfo",
      "description": "Who acts for a seat and where its darts come from.",
      "type": "object",
      "required": [
        "controllerUserId",
        "userId",
        "boardId",
        "boardName",
        "boardOnline",
        "controllerConnected",
        "disconnectedAt",
        "forfeited",
        "bot"
      ],
      "additionalProperties": false,
      "properties": {
        "controllerUserId": {
          "type": "string"
        },
        "userId": {
          "type": ["string", "null"],
          "description": "The account the seat plays for; null for a guest."
        },
        "boardId": {
          "type": ["string", "null"],
          "description": "null: darts are entered by hand."
        },
        "boardName": {
          "type": ["string", "null"]
        },
        "boardOnline": {
          "type": "boolean",
          "description": "The board's bridge is connected."
        },
        "controllerConnected": {
          "type": "boolean",
          "description": "The controller has this game open."
        },
        "disconnectedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Server time the controller's last socket of this game closed; null while they have it open, or if they haven't opened it since the server started."
        },
        "forfeited": {
          "type": "boolean"
        },
        "bot": {
          "anyOf": [
            {
              "type": "object",
              "required": ["level"],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The server throws for this seat itself, at this difficulty 1-10; null for a human or guest."
        }
      }
    },
    "SessionStatus": {
      "title": "SessionStatus",
      "type": "string",
      "enum": ["active", "finished", "aborted"]
    },
    "NoticeMessage": {
      "title": "NoticeMessage",
      "description": "A transient hint for this viewer, e.g. a dart thrown on a board that isn't up.",
      "type": "object",
      "required": ["type", "code", "boardId", "throwerName", "throwerBoard"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "notice"
        },
        "code": {
          "type": "string",
          "enum": ["not_your_turn"]
        },
        "boardId": {
          "type": "string"
        },
        "throwerName": {
          "type": "string",
          "description": "The player who is up."
        },
        "throwerBoard": {
          "type": ["string", "null"],
          "description": "Name of the board they throw on; null when they enter darts by hand."
        }
      }
    },
    "ErrorMessage": {
      "title": "ErrorMessage",
      "description": "An action of this viewer was refused.",
      "type": "object",
      "required": ["type", "code", "action"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": ["forbidden"]
        },
        "action": {
          "type": "string",
          "description": "The refused action's type."
        }
      }
    },
    "CameraMessage": {
      "title": "CameraMessage",
      "description": "A board in this game has a new camera still: fetch it from GET /api/boards/{boardId}/camera/{cam}?v={version}. Also sent for every stored still right after the first snapshot.",
      "type": "object",
      "required": ["type", "boardId", "cam", "version"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "camera"
        },
        "boardId": {
          "type": "string"
        },
        "cam": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Camera number, 0-based; 3 is the combined still."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Goes up with every still of this board and camera."
        }
      }
    },
    "X01Snapshot": {
      "title": "X01Snapshot",
      "type": "object",
      "required": [
        "type",
        "sessionId",
        "gameId",
        "boardId",
        "lobbyId",
        "lobbyName",
        "players",
        "game",
        "bmStatus",
        "status",
        "finishPending",
        "canUndoVisit",
        "ownerUserId",
        "seats",
        "mySeats"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "sessionId": {
          "type": "string"
        },
        "gameId": {
          "const": "x01"
        },
        "boardId": {
          "type": ["string", "null"]
        },
        "lobbyId": {
          "type": ["string", "null"],
          "description": "The lobby the game was started from; null for a local game."
        },
        "lobbyName": {
          "type": ["string", "null"],
          "description": "The lobby's name, for the match header; null for a local game."
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Player"
          }
        },
        "game": {
          "$ref": "#/$defs/X01Game"
        },
        "bmStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/BmStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Status of the board of the seat that's up."
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "finishPending": {
          "type": "boolean",
          "description": "The open visit wins the game: it waits for the Finish button (a takeout from the user), so its darts can still be corrected."
        },
        "canUndoVisit": {
          "type": "boolean",
          "description": "No darts are open and Undo would reopen the last committed visit (its thrower is up again, to correct it)."
        },
        "ownerUserId": {
          "type": "string",
          "description": "The host: starts the bull off, aborts the game."
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeatInfo"
          },
          "description": "Same order as players."
        },
        "mySeats": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Seats the viewer controls."
        }
      }
    },
    "AtcSnapshot": {
      "title": "AtcSnapshot",
      "type": "object",
      "required": [
        "type",
        "sessionId",
        "gameId",
        "boardId",
        "lobbyId",
        "lobbyName",
        "players",
        "game",
        "bmStatus",
        "status",
        "finishPending",
        "canUndoVisit",
        "ownerUserId",
        "seats",
        "mySeats"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "sessionId": {
          "type": "string"
        },
        "gameId": {
          "const": "atc"
        },
        "boardId": {
          "type": ["string", "null"]
        },
        "lobbyId": {
          "type": ["string", "null"],
          "description": "The lobby the game was started from; null for a local game."
        },
        "lobbyName": {
          "type": ["string", "null"],
          "description": "The lobby's name, for the match header; null for a local game."
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Player"
          }
        },
        "game": {
          "$ref": "#/$defs/AtcGame"
        },
        "bmStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/BmStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Status of the board of the seat that's up."
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "finishPending": {
          "type": "boolean",
          "description": "The open visit wins the game: it waits for the Finish button (a takeout from the user), so its darts can still be corrected."
        },
        "canUndoVisit": {
          "type": "boolean",
          "description": "No darts are open and Undo would reopen the last committed visit (its thrower is up again, to correct it)."
        },
        "ownerUserId": {
          "type": "string",
          "description": "The host: starts the bull off, aborts the game."
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeatInfo"
          },
          "description": "Same order as players."
        },
        "mySeats": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Seats the viewer controls."
        }
      }
    },
    "MinigolfPt": {
      "title": "MinigolfPt",
      "description": "A point in course space, [x, y]: millimetres, x right, y down.",
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "MinigolfHole": {
      "title": "MinigolfHole",
      "description": "A hole's geometry (see backend/src/shared/minigolf/types.ts).",
      "type": "object",
      "required": ["id", "name", "par", "outline", "walls", "bumpers", "slopes", "tee", "cup"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "par": {
          "type": "integer",
          "minimum": 1
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MinigolfPt"
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["points"],
            "additionalProperties": false,
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/MinigolfPt"
                }
              },
              "closed": {
                "type": "boolean"
              },
              "restitution": {
                "type": "number"
              }
            }
          }
        },
        "bumpers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "r"],
            "additionalProperties": false,
            "properties": {
              "at": {
                "$ref": "#/$defs/MinigolfPt"
              },
              "r": {
                "type": "number"
              },
              "restitution": {
                "type": "number"
              },
              "kick": {
                "type": "number"
              }
            }
          }
        },
        "slopes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["area", "force"],
                "additionalProperties": false,
                "properties": {
                  "area": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/MinigolfPt"
                    }
                  },
                  "force": {
                    "$ref": "#/$defs/MinigolfPt"
                  }
                }
              },
              {
                "type": "object",
                "required": ["area", "radial"],
                "additionalProperties": false,
                "properties": {
                  "area": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/MinigolfPt"
                    }
                  },
                  "radial": {
                    "type": "object",
                    "required": ["center", "strength"],
                    "additionalProperties": false,
                    "properties": {
                      "center": {
                        "$ref": "#/$defs/MinigolfPt"
                      },
                      "strength": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "tee": {
          "$ref": "#/$defs/MinigolfPt"
        },
        "cup": {
          "type": "object",
          "required": ["at", "r"],
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/MinigolfPt"
            },
            "r": {
              "type": "number"
            }
          }
        }
      }
    },
    "MinigolfGame": {
      "title": "MinigolfGame",
      "description": "Minigolf view plus the engine's per-session fields.",
      "type": "object",
      "required": [
        "winner",
        "finished",
        "currentPlayer",
        "visitLocked",
        "config",
        "courseName",
        "holeIdx",
        "holeCount",
        "hole",
        "pars",
        "holeNames",
        "order",
        "balls",
        "scores",
        "totals",
        "toPar",
        "tries",
        "lastHole",
        "currentVisitDarts",
        "totalDarts",
        "totalVisits"
      ],
      "additionalProperties": false,
      "properties": {
        "winner": {
          "type": ["integer", "null"]
        },
        "finished": {
          "type": "boolean"
        },
        "currentPlayer": {
          "type": "integer",
          "minimum": 0
        },
        "visitLocked": {
          "type": "boolean",
          "description": "No more darts this visit (all tries thrown, or the game is over)."
        },
        "config": {
          "type": "object",
          "required": ["course", "tries", "maxStrokes", "ballContact", "shotDelay"],
          "additionalProperties": false,
          "properties": {
            "course": {
              "type": "string"
            },
            "tries": {
              "enum": [1, 3]
            },
            "maxStrokes": {
              "type": "integer"
            },
            "ballContact": {
              "type": "boolean"
            },
            "shotDelay": {
              "type": "number"
            }
          }
        },
        "courseName": {
          "type": "string"
        },
        "holeIdx": {
          "type": "integer",
          "minimum": 0
        },
        "holeCount": {
          "type": "integer",
          "minimum": 1
        },
        "hole": {
          "$ref": "#/$defs/MinigolfHole"
        },
        "pars": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "holeNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Seats in turn order on this hole."
        },
        "balls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "strokes", "status"],
            "additionalProperties": false,
            "properties": {
              "at": {
                "$ref": "#/$defs/MinigolfPt"
              },
              "strokes": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": ["waiting", "playing", "holed", "done"]
              }
            }
          },
          "description": "Per seat, this hole. waiting: not putted yet (in hand); done: max strokes reached."
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": ["integer", "null"]
            }
          },
          "description": "Strokes per hole, then per seat; null until the hole is over."
        },
        "totals": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "toPar": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "tries": {
          "type": "array",
          "description": "The open visit's tries; the last one counts at takeout.",
          "items": {
            "type": "object",
            "required": ["label", "coords", "power", "holed", "missed", "path", "others"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "coords": {
                "anyOf": [
                  {
                    "$ref": "common-v1.json#/$defs/Coords"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "power": {
                "type": ["number", "null"]
              },
              "holed": {
                "type": "boolean"
              },
              "missed": {
                "type": "boolean"
              },
              "path": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/MinigolfPt"
                }
              },
              "others": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["seat", "path", "holed"],
                  "additionalProperties": false,
                  "properties": {
                    "seat": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "path": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/MinigolfPt"
                      }
                    },
                    "holed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "lastHole": {
          "anyOf": [
            {
              "type": "object",
              "required": ["index", "scores", "paths", "hole"],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "scores": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/MinigolfPt"
                      }
                    }
                  }
                },
                "hole": {
                  "$ref": "#/$defs/MinigolfHole"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The hole just finished: scores and every stroke's path per seat, for the scorecard."
        },
        "currentVisitDarts": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Dart"
          }
        },
        "totalDarts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "totalVisits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "MinigolfSnapshot": {
      "title": "MinigolfSnapshot",
      "type": "object",
      "required": [
        "type",
        "sessionId",
        "gameId",
        "boardId",
        "lobbyId",
        "lobbyName",
        "players",
        "game",
        "bmStatus",
        "status",
        "finishPending",
        "canUndoVisit",
        "ownerUserId",
        "seats",
        "mySeats"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "sessionId": {
          "type": "string"
        },
        "gameId": {
          "const": "minigolf"
        },
        "boardId": {
          "type": ["string", "null"]
        },
        "lobbyId": {
          "type": ["string", "null"],
          "description": "The lobby the game was started from; null for a local game."
        },
        "lobbyName": {
          "type": ["string", "null"],
          "description": "The lobby's name, for the match header; null for a local game."
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "common-v1.json#/$defs/Player"
          }
        },
        "game": {
          "$ref": "#/$defs/MinigolfGame"
        },
        "bmStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/BmStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Status of the board of the seat that's up."
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "finishPending": {
          "type": "boolean",
          "description": "The open visit wins the game: it waits for the Finish button (a takeout from the user), so its darts can still be corrected."
        },
        "canUndoVisit": {
          "type": "boolean",
          "description": "No darts are open and Undo would reopen the last committed visit (its thrower is up again, to correct it)."
        },
        "ownerUserId": {
          "type": "string",
          "description": "The host: starts the bull off, aborts the game."
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeatInfo"
          },
          "description": "Same order as players."
        },
        "mySeats": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Seats the viewer controls."
        }
      }
    },
    "Snapshot": {
      "title": "Snapshot",
      "description": "Full session state, pushed after every change.",
      "oneOf": [
        {
          "$ref": "#/$defs/X01Snapshot"
        },
        {
          "$ref": "#/$defs/AtcSnapshot"
        },
        {
          "$ref": "#/$defs/MinigolfSnapshot"
        }
      ]
    },
    "UserAction": {
      "title": "UserAction",
      "oneOf": [
        {
          "title": "UndoDartAction",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "undo_dart"
            }
          }
        },
        {
          "title": "TakeoutAction",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "takeout"
            }
          }
        },
        {
          "title": "AddDartAction",
          "type": "object",
          "required": ["type", "segment"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "add_dart"
            },
            "segment": {
              "$ref": "common-v1.json#/$defs/Segment"
            },
            "coords": {
              "$ref": "common-v1.json#/$defs/Coords",
              "description": "Where the dart landed (r = 1 at the outer double wire), when entered on the board."
            }
          }
        },
        {
          "title": "CorrectDartAction",
          "type": "object",
          "required": ["type", "visitIndex", "segment"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "correct_dart"
            },
            "visitIndex": {
              "type": "integer",
              "minimum": 0
            },
            "segment": {
              "$ref": "common-v1.json#/$defs/Segment"
            },
            "coords": {
              "$ref": "common-v1.json#/$defs/Coords",
              "description": "The dart's new spot when it was dragged on the board."
            }
          }
        },
        {
          "title": "BullOffSkipAction",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bulloff_skip"
            }
          }
        },
        {
          "title": "BullOffRethrowAction",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bulloff_rethrow"
            }
          }
        },
        {
          "title": "BullOffStartAction",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bulloff_start"
            }
          }
        },
        {
          "title": "ForfeitAction",
          "description": "Give up every seat the sender controls. The client sends no seats; the server fills them in before logging.",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "forfeit"
            },
            "seats": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "ClientMessage": {
      "title": "ClientMessage",
      "type": "object",
      "required": ["type", "action"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "user_action"
        },
        "action": {
          "$ref": "#/$defs/UserAction"
        }
      }
    }
  }
}
