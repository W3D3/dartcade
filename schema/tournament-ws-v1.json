{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tournament-ws/v1",
  "title": "TournamentWs",
  "description": "Messages the backend pushes on the tournament socket (/ws/tournament?tournamentId=…[&code=…]): the running state of one tournament, the same for everyone who may see it. It pushes the state again whenever something changed, and to organizers the venue devices in tournament mode (tournament.devices); the tournament's setup comes from GET /api/tournaments/{id}. The server closes it with a WsCloseCode from game-ws-v1.json (NotFound when the caller may not see the tournament). A device in tournament mode opens it with `device` (its name) and `deviceId` (kept by that browser), and after a reconnect or reload `hold`, the match it played (it gets it back unless another device took it meanwhile): organizers of an in-person tournament only (Forbidden otherwise). Only a device sends messages (TournamentClientMessage).",
  "$defs": {
    "TournamentLivePlayer": {
      "title": "TournamentLivePlayer",
      "type": "object",
      "required": ["userId", "name", "avatar"],
      "additionalProperties": false,
      "properties": {
        "userId": {
          "type": ["string", "null"],
          "description": "Null for a guest spot."
        },
        "name": {
          "type": "string"
        },
        "avatar": {
          "$ref": "common-v1.json#/$defs/Avatar"
        }
      }
    },
    "TournamentLiveEntry": {
      "title": "TournamentLiveEntry",
      "type": "object",
      "required": ["id", "name", "status", "seed", "finalPlace", "players"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "registered", "checked_in", "withdrawn"]
        },
        "seed": {
          "type": ["integer", "null"],
          "description": "Set at the draw."
        },
        "finalPlace": {
          "type": ["integer", "null"],
          "description": "Set when the tournament finished."
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLivePlayer"
          },
          "description": "In team order; a solo entry has one."
        }
      }
    },
    "TournamentLiveMatch": {
      "title": "TournamentLiveMatch",
      "type": "object",
      "required": ["key", "bracket", "group", "round", "index", "firstTo", "status", "sides", "outcome", "winner", "legs", "game"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique in the bracket, e.g. R2M3, L1M2, GF1, G2R1M1."
        },
        "bracket": {
          "type": "string",
          "enum": ["main", "lower", "final", "group"]
        },
        "group": {
          "type": ["integer", "null"]
        },
        "round": {
          "type": "integer"
        },
        "index": {
          "type": "integer",
          "description": "1-based position in its round, top first."
        },
        "firstTo": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "ready", "live", "finished"]
        },
        "sides": {
          "type": "array",
          "items": [
            {
              "type": ["string", "null"]
            },
            {
              "type": ["string", "null"]
            }
          ],
          "minItems": 2,
          "additionalItems": false,
          "description": "The entry ids playing, null while still to be decided (or nobody, in a bye)."
        },
        "outcome": {
          "type": ["string", "null"],
          "enum": ["played", "walkover", "bye", "organizer", null]
        },
        "winner": {
          "type": ["integer", "null"],
          "enum": [0, 1, null],
          "description": "The winning side once finished."
        },
        "legs": {
          "type": "array",
          "items": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "minItems": 2,
          "additionalItems": false,
          "description": "Legs won by each side: so far in a live match, the result in a finished one."
        },
        "game": {
          "oneOf": [
            {
              "type": "object",
              "required": ["sessionId", "throwing", "score"],
              "additionalProperties": false,
              "properties": {
                "sessionId": {
                  "type": "string",
                  "description": "The running game: Watch opens it, its players go back to it."
                },
                "throwing": {
                  "type": ["integer", "null"],
                  "enum": [0, 1, null],
                  "description": "The side whose turn it is."
                },
                "score": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "minItems": 2,
                      "additionalItems": false
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Each side's running score in the leg: X01's points left, Cricket's points; null in a bull off and in other games."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TournamentLiveStanding": {
      "title": "TournamentLiveStanding",
      "type": "object",
      "required": ["entryId", "played", "won", "lost", "legsWon", "legsLost"],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string"
        },
        "played": {
          "type": "integer"
        },
        "won": {
          "type": "integer"
        },
        "lost": {
          "type": "integer"
        },
        "legsWon": {
          "type": "integer"
        },
        "legsLost": {
          "type": "integer"
        }
      }
    },
    "TournamentLiveTable": {
      "title": "TournamentLiveTable",
      "type": "object",
      "required": ["group", "rows"],
      "additionalProperties": false,
      "description": "A group's table, or a round robin's (group null), best first.",
      "properties": {
        "group": {
          "type": ["integer", "null"]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLiveStanding"
          }
        }
      }
    },
    "TournamentLiveStage": {
      "title": "TournamentLiveStage",
      "type": "object",
      "required": ["bracket", "round", "name", "state", "at"],
      "additionalProperties": false,
      "properties": {
        "bracket": {
          "type": "string",
          "enum": ["main", "lower", "final", "group"]
        },
        "round": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "description": "Quarter-finals, Lower round 2, Grand final, Groups · round 1, …"
        },
        "state": {
          "type": "string",
          "enum": ["done", "now", "later"]
        },
        "at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "For a later stage: when it is expected to start."
        }
      }
    },
    "TournamentLiveMessage": {
      "title": "TournamentLiveMessage",
      "type": "object",
      "required": ["type", "tournamentId", "status", "entries", "matches", "tables", "schedule"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "tournament.live"
        },
        "tournamentId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "open", "check_in", "running", "finished", "cancelled"]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLiveEntry"
          },
          "description": "Withdrawn ones too, in registration order."
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLiveMatch"
          },
          "description": "Empty until the draw."
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLiveTable"
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentLiveStage"
          }
        }
      }
    },
    "TournamentDevice": {
      "title": "TournamentDevice",
      "type": "object",
      "required": ["id", "name", "matchKey"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "The browser's own id for itself."
        },
        "name": {
          "type": "string",
          "description": "Tablet · Bar: asked on first open, kept by that browser."
        },
        "matchKey": {
          "type": ["string", "null"],
          "description": "The match this device plays (TournamentLiveMatch.key); null: free. A live match no device plays is paused, and any device may continue it."
        }
      }
    },
    "TournamentDevicesMessage": {
      "title": "TournamentDevicesMessage",
      "type": "object",
      "required": ["type", "tournamentId", "devices"],
      "additionalProperties": false,
      "description": "To the tournament's organizers: the devices in tournament mode, at once whenever one comes, goes, is renamed or takes a match.",
      "properties": {
        "type": {
          "type": "string",
          "const": "tournament.devices"
        },
        "tournamentId": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TournamentDevice"
          },
          "description": "In the order they opened tournament mode."
        }
      }
    },
    "TournamentServerMessage": {
      "title": "TournamentServerMessage",
      "oneOf": [
        {
          "$ref": "#/$defs/TournamentLiveMessage"
        },
        {
          "$ref": "#/$defs/TournamentDevicesMessage"
        }
      ]
    },
    "TournamentClientMessage": {
      "title": "TournamentClientMessage",
      "description": "From a device in tournament mode. Anything else, or a match it may not take, is ignored.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "device.rename"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "matchKey"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "device.hold"
            },
            "matchKey": {
              "type": ["string", "null"],
              "description": "The match this device plays from now on (a ready one, or a paused one to continue); null lets it go. Refused while another device holds it, or once it finished."
            }
          }
        }
      ]
    }
  }
}
